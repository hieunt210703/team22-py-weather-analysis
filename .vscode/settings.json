{
  "editor.insertSpaces": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "[python]": {
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },
  "[markdown]": {
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  },
  "files.exclude": {
    "**/__pycache__": true,
    ".ruff_cache": true
  },
}
